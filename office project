<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>OfficeHub - Employee Portal</title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #08080d;
            color: white;
        }

        button,
        input,
        select {
            font-family: Arial, sans-serif;
        }

        .hidden {
            display: none !important;
        }


        /* ================================
           LOGIN / REGISTER
        ================================= */

        .auth-page {
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 20px;

            background:
                radial-gradient(
                    circle at top left,
                    #461078,
                    #0d0912 45%,
                    #08080d
                );
        }

        .auth-box {
            width: 100%;
            max-width: 450px;

            padding: 40px;

            background: #14141d;

            border: 1px solid #302d39;

            border-radius: 20px;

            box-shadow:
                0 20px 60px rgba(0,0,0,0.6);
        }

        .register-box {
            max-width: 700px;
        }


        /* LOGO */

        .logo {
            display: flex;
            align-items: center;
            justify-content: center;

            gap: 10px;

            margin-bottom: 25px;

            font-size: 26px;
            font-weight: bold;
        }

        .logo-icon {
            width: 45px;
            height: 45px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    #7c3aed,
                    #c026d3
                );

            font-size: 22px;
        }

        .purple {
            color: #b76cff;
        }


        /* HEADINGS */

        .auth-box h1 {
            text-align: center;

            font-size: 28px;

            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;

            color: #92929e;

            margin-bottom: 30px;

            font-size: 14px;
        }


        /* INPUT */

        .input-group {
            margin-bottom: 18px;
        }

        .input-group label {
            display: block;

            margin-bottom: 8px;

            font-size: 14px;

            color: #d0d0d8;
        }

        .input-group input,
        .input-group select {

            width: 100%;

            padding: 13px;

            border-radius: 9px;

            border: 1px solid #3a3843;

            background: #0e0e14;

            color: white;

            outline: none;

            font-size: 14px;
        }

        .input-group input:focus,
        .input-group select:focus {

            border-color: #9333ea;

            box-shadow:
                0 0 0 3px
                rgba(147,51,234,0.15);
        }


        /* REGISTER GRID */

        .form-grid {

            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 0 18px;
        }


        /* BUTTON */

        .main-btn {

            width: 100%;

            padding: 14px;

            margin-top: 8px;

            border: none;

            border-radius: 9px;

            background:
                linear-gradient(
                    135deg,
                    #7c3aed,
                    #a21caf
                );

            color: white;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;
        }

        .main-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 10px 25px
                rgba(124,58,237,0.4);
        }


        /* LINK */

        .bottom-text {

            text-align: center;

            margin-top: 22px;

            color: #92929e;

            font-size: 14px;
        }

        .link-btn {

            border: none;

            background: none;

            color: #b76cff;

            cursor: pointer;

            font-size: 14px;
        }

        .link-btn:hover {
            text-decoration: underline;
        }


        /* MESSAGE */

        .message {

            text-align: center;

            margin-top: 15px;

            font-size: 14px;
        }


        /* ================================
           DASHBOARD
        ================================= */

        .dashboard {

            min-height: 100vh;

            background: #08080d;
        }


        /* SIDEBAR */

        .sidebar {

            position: fixed;

            left: 0;
            top: 0;
            bottom: 0;

            width: 240px;

            background: #111118;

            border-right:
                1px solid #292932;

            padding: 25px 15px;

            display: flex;

            flex-direction: column;
        }

        .sidebar-logo {

            display: flex;

            align-items: center;

            gap: 10px;

            padding: 0 10px 25px;

            border-bottom:
                1px solid #292932;

            font-size: 20px;

            font-weight: bold;
        }

        .sidebar-logo .logo-icon {

            width: 38px;
            height: 38px;

            font-size: 18px;
        }


        /* MENU */

        .menu {

            margin-top: 25px;
        }

        .menu button {

            width: 100%;

            padding: 13px;

            margin-bottom: 7px;

            border: none;

            border-radius: 8px;

            background: transparent;

            color: #9999a5;

            text-align: left;

            cursor: pointer;

            font-size: 14px;
        }

        .menu button:hover {

            background: #241634;

            color: white;
        }

        .menu button.active {

            background: #29163f;

            color: #c084fc;
        }


        /* LOGOUT */

        .logout {

            margin-top: auto;

            width: 100%;

            padding: 13px;

            border-radius: 8px;

            border: 1px solid #512832;

            background: #24151a;

            color: #f87171;

            cursor: pointer;
        }


        /* MAIN */

        .main {

            margin-left: 240px;

            padding: 30px;
        }


        /* TOP */

        .topbar {

            display: flex;

            justify-content:
                space-between;

            align-items: center;

            margin-bottom: 30px;
        }

        .topbar h2 {
            font-size: 28px;
        }

        .topbar p {

            color: #858592;

            font-size: 13px;

            margin-top: 5px;
        }


        /* PROFILE */

        .profile {

            display: flex;

            align-items: center;

            gap: 10px;
        }

        .profile-icon {

            width: 42px;
            height: 42px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #7c3aed,
                    #a21caf
                );
        }

        .profile small {

            display: block;

            color: #777783;

            margin-top: 3px;
        }


        /* WELCOME */

        .welcome {

            padding: 25px;

            border-radius: 15px;

            margin-bottom: 25px;

            background:
                linear-gradient(
                    120deg,
                    #281044,
                    #17121f
                );

            border:
                1px solid #3b2855;
        }

        .welcome h1 {

            font-size: 24px;

            margin-bottom: 8px;
        }

        .welcome h1 span {

            color: #c084fc;
        }

        .welcome p {

            color: #92929e;

            font-size: 14px;
        }


        /* STATISTICS */

        .stats {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            gap: 18px;

            margin-bottom: 25px;
        }

        .stat {

            padding: 22px;

            background: #111118;

            border:
                1px solid #292932;

            border-radius: 13px;
        }

        .stat-icon {

            font-size: 25px;

            margin-bottom: 12px;
        }

        .stat p {

            color: #858592;

            font-size: 13px;

            margin-bottom: 6px;
        }

        .stat h2 {
            font-size: 25px;
        }


        /* PANELS */

        .panels {

            display: grid;

            grid-template-columns:
                2fr 1fr;

            gap: 20px;
        }

        .panel {

            background: #111118;

            border:
                1px solid #292932;

            border-radius: 13px;

            padding: 22px;
        }

        .panel h3 {

            margin-bottom: 18px;

            font-size: 17px;
        }


        /* ACTIVITY */

        .activity {

            display: flex;

            gap: 13px;

            padding: 15px 0;

            border-bottom:
                1px solid #292932;
        }

        .activity:last-child {
            border-bottom: none;
        }

        .activity-icon {

            width: 40px;
            height: 40px;

            display: flex;

            align-items: center;
            justify-content: center;

            background: #251537;

            border-radius: 8px;
        }

        .activity strong {
            font-size: 13px;
        }

        .activity p {

            color: #858592;

            font-size: 12px;

            margin-top: 5px;
        }


        /* INFORMATION */

        .info-row {

            display: flex;

            justify-content:
                space-between;

            gap: 10px;

            padding: 13px 0;

            border-bottom:
                1px solid #292932;

            font-size: 13px;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row span {
            color: #b084f5;

            text-align: right;
        }


        /* OTHER SECTIONS */

        .section {

            background: #111118;

            border:
                1px solid #292932;

            border-radius: 13px;

            padding: 25px;
        }

        .section h1 {

            margin-bottom: 10px;
        }

        .section p {

            color: #92929e;

            line-height: 1.6;
        }


        /* RESPONSIVE */

        @media(max-width: 900px) {

            .stats {

                grid-template-columns:
                    repeat(2,1fr);
            }

            .panels {

                grid-template-columns: 1fr;
            }
        }


        @media(max-width: 650px) {

            .sidebar {

                width: 65px;

                padding: 20px 7px;
            }

            .sidebar-logo span {

                display: none;
            }

            .menu button {

                font-size: 0;

                text-align: center;
            }

            .menu button:first-letter {

                font-size: 20px;
            }

            .logout {

                font-size: 0;
            }

            .logout::before {

                content: "🚪";

                font-size: 18px;
            }

            .main {

                margin-left: 65px;

                padding: 20px;
            }

            .form-grid {

                grid-template-columns: 1fr;
            }

            .stats {

                grid-template-columns: 1fr;
            }

            .profile {

                display: none;
            }
        }

    </style>

</head>


<body>


<!-- =====================================================
     LOGIN
====================================================== -->

<div id="loginPage" class="auth-page">

    <div class="auth-box">

        <div class="logo">

            <div class="logo-icon">
                O
            </div>

            <span>
                Office<span class="purple">Hub</span>
            </span>

        </div>


        <h1>Welcome Back</h1>

        <p class="subtitle">
            Login to your employee account
        </p>


        <form id="loginForm">

            <div class="input-group">

                <label>Email Address</label>

                <input
                    type="email"
                    id="loginEmail"
                    placeholder="Enter your email"
                    required
                >

            </div>


            <div class="input-group">

                <label>Password</label>

                <input
                    type="password"
                    id="loginPassword"
                    placeholder="Enter your password"
                    required
                >

            </div>


            <button
                type="submit"
                class="main-btn">

                Login

            </button>

        </form>


        <p class="bottom-text">

            Don't have an account?

            <button
                class="link-btn"
                onclick="openRegister()">

                Create Account

            </button>

        </p>


        <p
            id="loginMessage"
            class="message">
        </p>

    </div>

</div>



<!-- =====================================================
     CREATE ACCOUNT
====================================================== -->

<div id="registerPage"
     class="auth-page hidden">

    <div class="auth-box register-box">

        <div class="logo">

            <div class="logo-icon">
                O
            </div>

            <span>
                Office<span class="purple">Hub</span>
            </span>

        </div>


        <h1>Create Employee Account</h1>

        <p class="subtitle">
            Enter your employee information
        </p>


        <form id="registerForm">

            <div class="form-grid">


                <div class="input-group">

                    <label>Full Name</label>

                    <input
                        type="text"
                        id="name"
                        placeholder="Enter full name"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Employee ID</label>

                    <input
                        type="text"
                        id="employeeId"
                        placeholder="EMP001"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Email</label>

                    <input
                        type="email"
                        id="email"
                        placeholder="employee@gmail.com"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Phone</label>

                    <input
                        type="tel"
                        id="phone"
                        placeholder="9876543210"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Department</label>

                    <select id="department" required>

                        <option value="">
                            Select Department
                        </option>

                        <option>
                            IT
                        </option>

                        <option>
                            HR
                        </option>

                        <option>
                            Finance
                        </option>

                        <option>
                            Marketing
                        </option>

                        <option>
                            Sales
                        </option>

                        <option>
                            Management
                        </option>

                    </select>

                </div>


                <div class="input-group">

                    <label>Position</label>

                    <input
                        type="text"
                        id="position"
                        placeholder="Software Developer"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <input
                        type="password"
                        id="password"
                        placeholder="Minimum 6 characters"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Confirm Password</label>

                    <input
                        type="password"
                        id="confirmPassword"
                        placeholder="Confirm password"
                        required
                    >

                </div>

            </div>


            <button
                type="submit"
                class="main-btn">

                Create Account

            </button>

        </form>


        <p class="bottom-text">

            Already have an account?

            <button
                class="link-btn"
                onclick="openLogin()">

                Login

            </button>

        </p>


        <p
            id="registerMessage"
            class="message">
        </p>

    </div>

</div>



<!-- =====================================================
     DASHBOARD
====================================================== -->

<div id="dashboardPage"
     class="dashboard hidden">


    <!-- SIDEBAR -->

    <aside class="sidebar">


        <div class="sidebar-logo">

            <div class="logo-icon">
                O
            </div>

            <span>
                Office<span class="purple">Hub</span>
            </span>

        </div>


        <div class="menu">


            <button
                class="active"
                onclick="dashboardSection()">

                🏠
                <span>Dashboard</span>

            </button>


            <button
                onclick="showSimpleSection('Employees')">

                👥
                <span>Employees</span>

            </button>


            <button
                onclick="showSimpleSection('Projects')">

                📁
                <span>Projects</span>

            </button>


            <button
                onclick="showSimpleSection('Attendance')">

                📅
                <span>Attendance</span>

            </button>


            <button
                onclick="showSimpleSection('Tasks')">

                ✅
                <span>Tasks</span>

            </button>


            <button
                onclick="showSimpleSection('Messages')">

                💬
                <span>Messages</span>

            </button>


            <button
                onclick="showSimpleSection('Settings')">

                ⚙️
                <span>Settings</span>

            </button>

        </div>


        <button
            class="logout"
            onclick="logout()">

            🚪 Logout

        </button>

    </aside>



    <!-- MAIN -->

    <main class="main">


        <div class="topbar">

            <div>

                <h2 id="pageTitle">
                    Employee Dashboard
                </h2>

                <p>
                    Office Management System
                </p>

            </div>


            <div class="profile">

                <div class="profile-icon">
                    👤
                </div>

                <div>

                    <strong id="dashboardName">
                        Employee
                    </strong>

                    <small id="dashboardDepartment">
                        Department
                    </small>

                </div>

            </div>

        </div>



        <!-- DASHBOARD CONTENT -->

        <div id="dashboardContent">


            <div class="welcome">

                <h1>
                    Welcome,
                    <span id="welcomeName">
                        Employee
                    </span>! 👋
                </h1>

                <p>
                    Welcome to your employee dashboard.
                    Here you can manage your office activities.
                </p>

            </div>



            <!-- STATISTICS -->

            <div class="stats">


                <div class="stat">

                    <div class="stat-icon">
                        👥
                    </div>

                    <p>
                        Total Employees
                    </p>

                    <h2>
                        120
                    </h2>

                </div>


                <div class="stat">

                    <div class="stat-icon">
                        📁
                    </div>

                    <p>
                        Active Projects
                    </p>

                    <h2>
                        18
                    </h2>

                </div>


                <div class="stat">

                    <div class="stat-icon">
                        📅
                    </div>

                    <p>
                        Attendance
                    </p>

                    <h2>
                        95%
                    </h2>

                </div>


                <div class="stat">

                    <div class="stat-icon">
                        ✅
                    </div>

                    <p>
                        Completed Tasks
                    </p>

                    <h2>
                        64
                    </h2>

                </div>

            </div>



            <!-- PANELS -->

            <div class="panels">


                <!-- ACTIVITIES -->

                <div class="panel">

                    <h3>
                        Recent Activities
                    </h3>


                    <div class="activity">

                        <div class="activity-icon">
                            📁
                        </div>

                        <div>

                            <strong>
                                New project assigned
                            </strong>

                            <p>
                                Project Alpha has been
                                assigned to your team.
                            </p>

                        </div>

                    </div>


                    <div class="activity">

                        <div class="activity-icon">
                            📅
                        </div>

                        <div>

                            <strong>
                                Meeting scheduled
                            </strong>

                            <p>
                                Team meeting scheduled
                                for tomorrow.
                            </p>

                        </div>

                    </div>


                    <div class="activity">

                        <div class="activity-icon">
                            ✅
                        </div>

                        <div>

                            <strong>
                                Task completed
                            </strong>

                            <p>
                                Website design task
                                has been completed.
                            </p>

                        </div>

                    </div>

                </div>



                <!-- EMPLOYEE INFORMATION -->

                <div class="panel">

                    <h3>
                        Employee Information
                    </h3>


                    <div class="info-row">

                        <strong>
                            Name
                        </strong>

                        <span id="infoName">
                            -
                        </span>

                    </div>


                    <div class="info-row">

                        <strong>
                            Employee ID
                        </strong>

                        <span id="infoEmployee">
                            -
                        </span>

                    </div>


                    <div class="info-row">

                        <strong>
                            Email
                        </strong>

                        <span id="infoEmail">
                            -
                        </span>

                    </div>


                    <div class="info-row">

                        <strong>
                            Department
                        </strong>

                        <span id="infoDepartment">
                            -
                        </span>

                    </div>


                    <div class="info-row">

                        <strong>
                            Position
                        </strong>

                        <span id="infoPosition">
                            -
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>



<script>


/* ==========================================
   GET ELEMENTS
========================================== */

const loginPage =
    document.getElementById("loginPage");

const registerPage =
    document.getElementById("registerPage");

const dashboardPage =
    document.getElementById("dashboardPage");



/* ==========================================
   OPEN REGISTER
========================================== */

function openRegister() {

    loginPage.classList.add("hidden");

    registerPage.classList.remove("hidden");

    dashboardPage.classList.add("hidden");

}



/* ==========================================
   OPEN LOGIN
========================================== */

function openLogin() {

    registerPage.classList.add("hidden");

    loginPage.classList.remove("hidden");

    dashboardPage.classList.add("hidden");

}



/* ==========================================
   OPEN DASHBOARD
========================================== */

function openDashboard() {

    loginPage.classList.add("hidden");

    registerPage.classList.add("hidden");

    dashboardPage.classList.remove("hidden");

    loadEmployee();

}



/* ==========================================
   CREATE ACCOUNT
========================================== */

document
    .getElementById("registerForm")
    .addEventListener("submit", function(event) {

        event.preventDefault();


        const name =
            document.getElementById("name").value.trim();

        const employeeId =
            document.getElementById("employeeId").value.trim();

        const email =
            document.getElementById("email").value.trim();

        const phone =
            document.getElementById("phone").value.trim();

        const department =
            document.getElementById("department").value;

        const position =
            document.getElementById("position").value.trim();

        const password =
            document.getElementById("password").value;

        const confirmPassword =
            document.getElementById("confirmPassword").value;

        const message =
            document.getElementById("registerMessage");


        /* PASSWORD CHECK */

        if (password.length < 6) {

            message.textContent =
                "Password must be at least 6 characters.";

            message.style.color = "#f87171";

            return;
        }


        /* CONFIRM PASSWORD */

        if (password !== confirmPassword) {

            message.textContent =
                "Passwords do not match.";

            message.style.color = "#f87171";

            return;
        }


        /* CREATE EMPLOYEE */

        const employee = {

            name: name,

            employeeId: employeeId,

            email: email,

            phone: phone,

            department: department,

            position: position,

            password: password

        };


        /* SAVE EMPLOYEE */

        localStorage.setItem(
            "employee",
            JSON.stringify(employee)
        );


        /* SUCCESS */

        message.textContent =
            "Account created successfully!";

        message.style.color =
            "#4ade80";


        /* CLEAR FORM */

        document
            .getElementById("registerForm")
            .reset();


        /* GO LOGIN */

        setTimeout(function() {

            openLogin();

            document
                .getElementById("loginEmail")
                .value = email;

        }, 1000);

    });



/* ==========================================
   LOGIN
========================================== */

document
    .getElementById("loginForm")
    .addEventListener("submit", function(event) {

        event.preventDefault();


        const email =
            document
                .getElementById("loginEmail")
                .value
                .trim();

        const password =
            document
                .getElementById("loginPassword")
                .value;


        const message =
            document.getElementById("loginMessage");


        /* GET EMPLOYEE */

        const savedEmployee =
            localStorage.getItem("employee");


        if (!savedEmployee) {

            message.textContent =
                "No account found. Please create an account first.";

            message.style.color =
                "#f87171";

            return;

        }


        const employee =
            JSON.parse(savedEmployee);


        /* CHECK LOGIN */

        if (
            email === employee.email &&
            password === employee.password
        ) {

            /* LOGIN SUCCESS */

            localStorage.setItem(
                "loggedIn",
                "yes"
            );


            message.textContent =
                "Login successful!";

            message.style.color =
                "#4ade80";


            setTimeout(function() {

                openDashboard();

            }, 500);

        }

        else {

            message.textContent =
                "Wrong email or password.";

            message.style.color =
                "#f87171";

        }

    });



/* ==========================================
   LOAD EMPLOYEE
========================================== */

function loadEmployee() {

    const savedEmployee =
        localStorage.getItem("employee");


    if (!savedEmployee) {
        return;
    }


    const employee =
        JSON.parse(savedEmployee);


    document
        .getElementById("dashboardName")
        .textContent =
        employee.name;


    document
        .getElementById("dashboardDepartment")
        .textContent =
        employee.department;


    document
        .getElementById("welcomeName")
        .textContent =
        employee.name;


    document
        .getElementById("infoName")
        .textContent =
        employee.name;


    document
        .getElementById("infoEmployee")
        .textContent =
        employee.employeeId;


    document
        .getElementById("infoEmail")
        .textContent =
        employee.email;


    document
        .getElementById("infoDepartment")
        .textContent =
        employee.department;


    document
        .getElementById("infoPosition")
        .textContent =
        employee.position;

}



/* ==========================================
   DASHBOARD BUTTON
========================================== */

function dashboardSection() {

    document
        .getElementById("pageTitle")
        .textContent =
        "Employee Dashboard";


    document
        .getElementById("dashboardContent")
        .classList.remove("hidden");

}



/* ==========================================
   OTHER MENU ITEMS
========================================== */

function showSimpleSection(name) {

    document
        .getElementById("pageTitle")
        .textContent =
        name;


    document
        .getElementById("dashboardContent")
        .innerHTML = `

            <div class="section">

                <h1>
                    ${name}
                </h1>

                <p>
                    The ${name} section is ready
                    for development.
                </p>

            </div>

        `;

}



/* ==========================================
   LOGOUT
========================================== */

function logout() {

    localStorage.removeItem("loggedIn");


    document
        .getElementById("loginEmail")
        .value = "";


    document
        .getElementById("loginPassword")
        .value = "";


    openLogin();

}



/* ==========================================
   CHECK LOGIN ON REFRESH
========================================== */

window.addEventListener(
    "load",
    function() {

        const loggedIn =
            localStorage.getItem("loggedIn");


        if (loggedIn === "yes") {

            openDashboard();

        }

        else {

            openLogin();

        }

    }
);

</script>


